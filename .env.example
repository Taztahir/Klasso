# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file.

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Google Gemini AI Key (if used for internal tooling)
VITE_GEMINI_API_KEY=your_gemini_api_key

# Paystack Public Key (public keys are safe to be on frontend)
# Use pk_test_ for development, pk_live_ for production
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_key_here

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Web3Forms (contact/newsletter form submissions)
VITE_WEB3FORMS_KEY=your_web3forms_key

# Site URL
VITE_SITE_URL=https://klasso.app
