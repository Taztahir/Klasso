{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/dashboard/assignments",
      "regex": "^/dashboard/assignments(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/assignments(?:/)?$"
    },
    {
      "page": "/dashboard/cbt",
      "regex": "^/dashboard/cbt(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/cbt(?:/)?$"
    },
    {
      "page": "/dashboard/finance",
      "regex": "^/dashboard/finance(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/finance(?:/)?$"
    },
    {
      "page": "/dashboard/notes",
      "regex": "^/dashboard/notes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/notes(?:/)?$"
    },
    {
      "page": "/dashboard/overview",
      "regex": "^/dashboard/overview(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/overview(?:/)?$"
    },
    {
      "page": "/dashboard/report-cards",
      "regex": "^/dashboard/report\\-cards(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/report\\-cards(?:/)?$"
    },
    {
      "page": "/dashboard/settings",
      "regex": "^/dashboard/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/settings(?:/)?$"
    },
    {
      "page": "/dashboard/staff",
      "regex": "^/dashboard/staff(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/staff(?:/)?$"
    },
    {
      "page": "/dashboard/students",
      "regex": "^/dashboard/students(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/students(?:/)?$"
    },
    {
      "page": "/icon.svg",
      "regex": "^/icon\\.svg(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/icon\\.svg(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/signup",
      "regex": "^/signup(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/signup(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}